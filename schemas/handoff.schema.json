{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/handoff.schema.json",
  "title": "Fenced task handoff",
  "type": "object",
  "required": ["schema_version", "task_id", "lease_generation", "branch", "base_commit", "head_commit", "decision_ids", "submitted_at", "changed_files", "notes"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
    "lease_generation": {"type": "integer", "minimum": 1},
    "branch": {"type": "string", "pattern": "^task/T-[0-9]{3}-g[1-9][0-9]*$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"}
    },
    "submitted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "changed_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
