{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/decision.schema.json",
  "title": "Confirmed project decision",
  "type": "object",
  "required": ["schema_version", "decision_id", "title", "status", "confirmed_by", "confirmed_at", "scope", "decisions", "affected_files"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"const": "confirmed"},
    "confirmed_by": {"type": "string", "minLength": 1},
    "confirmed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "supersedes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"}
    },
    "affected_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
