{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/decision.schema.json",
  "title": "Confirmed project decision",
  "type": "object",
  "required": ["schema_version", "decision_id", "title", "status", "confirmed_by", "confirmed_at", "scope", "decisions", "affected_files"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"const": "confirmed"},
    "confirmed_by": {"type": "string", "minLength": 1},
    "confirmed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resolved_pending": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "line_sha256", "resolution"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(Settings|设定书)/.+"
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "supersedes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"}
    },
    "historical_backfill": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["commit", "reason"],
        "properties": {
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "affected_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
