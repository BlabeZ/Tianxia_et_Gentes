{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/snapshot.schema.json",
  "title": "Read-only exported HOI4 state metadata",
  "type": "object",
  "required": ["schema_version", "generated_at", "generated_by_machine", "game_version", "source", "states"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [2, 3]},
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "generated_by_machine": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "game_version": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["relative_root", "file_count", "fingerprint"],
      "properties": {
        "relative_root": {"const": "history/states"},
        "file_count": {"type": "integer", "minimum": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "state_category_source": {
      "type": "object",
      "required": ["relative_root", "file_count", "fingerprint"],
      "properties": {
        "relative_root": {"const": "common/state_category"},
        "file_count": {"type": "integer", "minimum": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "state_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "local_building_slots", "source_relative_path", "source_sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "local_building_slots": {"type": "integer", "minimum": 0},
          "source_relative_path": {
            "type": "string",
            "pattern": "^common/state_category/[^/\\\\]+\\.txt$"
          },
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state_id", "localisation_key", "relative_path", "province_count", "provinces", "sha256"],
        "properties": {
          "state_id": {"type": "integer", "minimum": 1},
          "localisation_key": {"type": "string", "pattern": "^STATE_[0-9]+$"},
          "relative_path": {"type": "string", "pattern": "^history/states/[^/\\\\]+\\.txt$"},
          "province_count": {"type": "integer", "minimum": 0},
          "state_category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "provinces": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
