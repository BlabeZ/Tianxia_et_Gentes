{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/state-overrides.schema.json",
  "title": "Declarative HOI4 state overrides",
  "type": "object",
  "required": ["schema_version", "decision_id", "source_fingerprint", "overrides"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "overrides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state_id", "source_relative_path", "source_sha256"],
        "properties": {
          "state_id": {"type": "integer", "minimum": 1},
          "source_relative_path": {
            "type": "string",
            "pattern": "^history/states/[^/\\\\]+\\.txt$"
          },
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "owner": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,}$"},
          "controller": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,}$"},
          "add_core_of": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,}$"}
          },
          "add_claim_by": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,}$"}
          },
          "manpower": {"type": "integer", "minimum": 0},
          "state_category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "resources": {
            "type": "object",
            "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
          },
          "buildings": {
            "type": "object",
            "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
