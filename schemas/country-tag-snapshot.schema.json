{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/country-tag-snapshot.schema.json",
  "title": "Read-only exported HOI4 country tag metadata",
  "type": "object",
  "required": ["schema_version", "generated_at", "generated_by_machine", "game_version", "sources", "tags"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "generated_by_machine": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "game_version": {"type": ["string", "null"]},
    "sources": {
      "type": "object",
      "required": ["registries", "definitions", "histories"],
      "properties": {
        "registries": {
          "type": "object",
          "required": ["relative_root", "file_count", "fingerprint"],
          "properties": {
            "relative_root": {"const": "common/country_tags"},
            "file_count": {"type": "integer", "minimum": 1},
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "definitions": {
          "type": "object",
          "required": ["relative_root", "file_count", "fingerprint"],
          "properties": {
            "relative_root": {"const": "common/countries"},
            "file_count": {"type": "integer", "minimum": 0},
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "histories": {
          "type": "object",
          "required": ["relative_root", "file_count", "fingerprint"],
          "properties": {
            "relative_root": {"const": "history/countries"},
            "file_count": {"type": "integer", "minimum": 0},
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tag", "registry_relative_path", "registry_sha256", "definition", "history"],
        "properties": {
          "tag": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2}$"},
          "registry_relative_path": {
            "type": "string",
            "pattern": "^common/country_tags/.+\\.txt$"
          },
          "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "definition": {
            "type": "object",
            "required": ["relative_path", "exists", "sha256"],
            "properties": {
              "relative_path": {"type": "string", "pattern": "^common/countries/.+\\.txt$"},
              "exists": {"type": "boolean"},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          },
          "history": {
            "type": "object",
            "required": ["exists", "files"],
            "properties": {
              "exists": {"type": "boolean"},
              "files": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["relative_path", "sha256"],
                  "properties": {
                    "relative_path": {"type": "string", "pattern": "^history/countries/.+\\.txt$"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
