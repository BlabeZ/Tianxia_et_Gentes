{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia-et-gentes.local/schemas/political-spectrum.schema.json",
  "title": "天下与万邦五轴政治坐标契约（8+N+5，D-20260812-056）",
  "description": "五轴模型：E 经济（自由放任 -100 ↔ 计划经济 +100）、P 政治（分权 -100 ↔ 威权 +100）、F 外交（国际主义 -100 ↔ 民族主义 +100）、L 左右（左翼 -100 ↔ 右翼 +100）、O 秩序（革命 -100 ↔ 反动 +100）。意识形态=类别、坐标=属性。基础坐标=子意识形态理论中心点；国家修正=实际制度偏移。",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{3}$"},
    "title": {"type": "string"},
    "note": {"type": "string"},
    "spectrum": {
      "type": "object",
      "required": ["e", "p", "f", "l", "o"],
      "properties": {
        "e": {"const": "economy"},
        "p": {"const": "power_structure"},
        "f": {"const": "foreign_identity"},
        "l": {"const": "left_right"},
        "o": {"const": "order_stance"}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["regime", "engine_pole"],
      "properties": {
        "regime": {
          "type": "object",
          "description": "政体标签阈值（P 轴，T-046 政体判定脚本化）",
          "required": ["decentralized_max", "authoritarian_min"],
          "properties": {
            "decentralized_max": {"type": "integer", "minimum": -100, "maximum": 0},
            "authoritarian_min": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "engine_pole": {
          "type": "object",
          "description": "五轴组合判据 → 引擎四极（双轨一致性，与 docs/意识形态-跨极映射表.md 二节一致；依次特判命中即停）",
          "required": [
            "communism_l_max",
            "communism_e_min",
            "communism_o_max",
            "fascism_l_min",
            "fascism_f_min",
            "fascism_p_min",
            "democratic_p_max"
          ],
          "properties": {
            "communism_l_max": {"type": "integer", "minimum": -100, "maximum": 100},
            "communism_e_min": {"type": "integer", "minimum": -100, "maximum": 100},
            "communism_o_max": {"type": "integer", "minimum": -100, "maximum": 100},
            "fascism_l_min": {"type": "integer", "minimum": -100, "maximum": 100},
            "fascism_f_min": {"type": "integer", "minimum": -100, "maximum": 100},
            "fascism_p_min": {"type": "integer", "minimum": -100, "maximum": 100},
            "democratic_p_max": {"type": "integer", "minimum": -100, "maximum": 100}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "default_coordinates": {
      "type": "object",
      "description": "40 子意识形态默认坐标（subtype key → 五轴），key 必须取自 40 子类型清单",
      "additionalProperties": {
        "$ref": "#/$defs/coordinate"
      }
    },
    "party_coordinates": {
      "type": "object",
      "description": "各国政党坐标（TXG_<TAG>_<party> → 五轴 + 绑定子类型）",
      "additionalProperties": {
        "type": "object",
        "required": ["country_tag", "subtype", "e", "p", "f", "l", "o"],
        "properties": {
          "country_tag": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,}$"},
          "subtype": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "e": {"type": "integer", "minimum": -100, "maximum": 100},
          "p": {"type": "integer", "minimum": -100, "maximum": 100},
          "f": {"type": "integer", "minimum": -100, "maximum": 100},
          "l": {"type": "integer", "minimum": -100, "maximum": 100},
          "o": {"type": "integer", "minimum": -100, "maximum": 100}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["e", "p", "f", "l", "o"],
      "properties": {
        "e": {"type": "integer", "minimum": -100, "maximum": 100},
        "p": {"type": "integer", "minimum": -100, "maximum": 100},
        "f": {"type": "integer", "minimum": -100, "maximum": 100},
        "l": {"type": "integer", "minimum": -100, "maximum": 100},
        "o": {"type": "integer", "minimum": -100, "maximum": 100}
      },
      "additionalProperties": false
    }
  }
}
