#!/bin/sh
set -eu

remote_name=${1:-origin}
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
runner="$repo_root/.githooks/run-python"
zero_sha=0000000000000000000000000000000000000000

"$runner" scripts/workflow.py validate
"$runner" -m unittest discover -s tests -v

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero_sha" ]; then
        continue
    fi
    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    base_sha=$remote_sha
    if [ "$remote_sha" = "$zero_sha" ]; then
        remote_main="refs/remotes/$remote_name/main"
        if ! git show-ref --verify --quiet "$remote_main"; then
            echo "ERROR: cannot derive validation base for new branch; fetch $remote_name/main first" >&2
            exit 1
        fi
        base_sha=$(git merge-base "$local_sha" "$remote_main")
    fi

    "$runner" scripts/workflow.py validate --base "$base_sha" --head "$local_sha"
done
